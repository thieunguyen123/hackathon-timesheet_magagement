APP_NAME=Timesheet
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=timesheet
DB_USERNAME=timesheet
DB_PASSWORD=secret

SESSION_DRIVER=array
CACHE_STORE=array
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

MAIL_MAILER=log

# Connecteam time-clock integration (leave empty to use demo data generator)
CONNECTEAM_API_KEY=
CONNECTEAM_BASE_URL=https://api.connecteam.com
CONNECTEAM_TIMECLOCK_ID=

# Slack incoming webhook for request notifications (optional)
SLACK_WEBHOOK_URL=
